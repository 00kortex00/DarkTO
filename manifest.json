{
  "manifest_version": 3,
  "name": "DarkTO",
  "version": "2.0.0",
  "action": { "default_popup": "index.html" },
  "icons": {
    "256": "src/assets/logo-256x.png",
    "128": "src/assets/logo-128x.png",
    "48": "src/assets/logo-48x.png",
    "16": "src/assets/logo-16x.png"
  },
  "content_scripts": [
    {
        "js": ["src/content/main.tsx"],
        "matches": ["https://tankionline.com/play/*"]
    }
  ]
}